[Applet Factory]
Id=MateWindowPickerFactory
Location=@APPLET_LOCATION@
InProcess=@ENABLE_IN_PROCESS@
Name=Window Picker Applet Factory
Description=Window Picker

[MateWindowPicker]
Name=Netbook Window Picker
Description=Switch between open windows using their icons for small screens
# Translators: Do NOT translate or transliterate this text (this is an icon file name)!
Icon=preferences-system-windows
MateComponentId=OAFIID:MATE_WindowPicker
Platforms=X11;

